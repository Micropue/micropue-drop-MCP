# Copy this file to .env and fill in the API key. The MCP server loads the
# project root .env automatically; existing process environment variables win.

DROP_API_KEY=replace-with-your-drop-api-key
DROP_API_BASE=https://drop.micropue.com.cn/v1
DROP_REQUEST_TIMEOUT_MS=20000

# macOS/Linux: separate multiple directories with ":".
# Windows: separate multiple directories with ";".
DROP_ALLOWED_ROOTS=/absolute/path/to/sites
